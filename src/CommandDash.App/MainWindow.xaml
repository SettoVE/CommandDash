<Window x:Class="CommandDash.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CommandDash" Height="680" Width="1040"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel LastChildFill="True">
                <!-- App title -->
                <!--<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,20,18,16">
                    <TextBlock Text="CommandDash" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>-->

                <!-- Search box -->
                <!--<Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}" CornerRadius="8"
                        Margin="14,0,14,14" Padding="8,6">
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             CaretBrush="{StaticResource TextPrimaryBrush}"
                             Tag="Search modules..."/>
                </Border>-->

                <!-- Navigation categories / module list -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavPanel" Margin="0,12,0,12">
                        <!--<TextBlock Text="GENERAL" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" FontWeight="SemiBold" Margin="20,8,0,4"/>-->
                        <RadioButton Content="Dashboard" GroupName="Nav" Style="{StaticResource NavItemStyle}" IsChecked="True"/>

                        <TextBlock Text="MODULES" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" FontWeight="SemiBold" Margin="20,16,0,4"/>
                        <!-- Module nav items will be generated dynamically once module loading is implemented -->
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Content area -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,20">
                <TextBlock Text="Dashboard" Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="26" FontWeight="Bold"/>
            </StackPanel>

            <!-- Module cards grid -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ModuleCardsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ModuleCardStyle}" Width="220" Height="110">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
