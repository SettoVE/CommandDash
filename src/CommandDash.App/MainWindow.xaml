<Window x:Class="CommandDash.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CommandDash" Height="680" Width="1040"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel LastChildFill="True">
                <!-- App title -->
                <!--<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,20,18,16">
                    <TextBlock Text="CommandDash" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>-->

                <!-- Settings button pinned to the bottom of the sidebar -->
                <Button DockPanel.Dock="Bottom" Content="Settings" Click="OpenSettings_Click"
                        HorizontalAlignment="Stretch" Margin="14,8,14,14" Padding="8,6"/>

                <!-- Navigation: populated dynamically from loaded modules, in customizable order.
                     Each item is prefixed with its number key shortcut (1-9, 0 for the 10th). -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavPanel" Margin="0,12,0,12"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Custom per-module background; translucent when none is set -->
        <Border x:Name="BackgroundPanel" Grid.Column="1" Background="{x:Null}" IsHitTestVisible="False"
                RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="False"/>
        <Border x:Name="BackgroundFadePanel" Grid.Column="1" Background="{x:Null}" IsHitTestVisible="False"
                RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="False"/>

        <!-- Content area: hosts the active module's page view -->
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--<TextBlock x:Name="PageTitle" Grid.Row="0" Text="" Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="26" FontWeight="Bold" Margin="0,0,0,20"/>-->

            <ContentControl x:Name="ModuleContentHost" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
