<UserControl x:Class="CommandDash.App.Settings.SettingsSectionHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch">
    <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="TitleText" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold"/>

        <Border Grid.Column="1" Height="2" Margin="10,2,0,0" VerticalAlignment="Center"
                Background="{DynamicResource TextPrimaryBrush}"/>
    </Grid>
</UserControl>
