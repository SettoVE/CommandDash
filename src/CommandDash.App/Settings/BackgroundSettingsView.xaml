<UserControl x:Class="CommandDash.App.Settings.BackgroundSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CommandDash.App.Settings">
    <StackPanel Margin="4">
        <local:SettingsSectionHeader Title="Backgrounds"/>

        <ComboBox x:Name="ModuleComboBox"
                  SelectionChanged="ModuleComboBox_SelectionChanged">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayName}"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="PathTextBox" Grid.Column="0" IsReadOnly="True" VerticalContentAlignment="Center"
                     Padding="4,4"/>
            <Button Grid.Column="1" Content="Select" Click="Select_Click" Padding="10,4" Margin="8,0,0,0"/>
            <Button Grid.Column="2" Content="Default" Click="Default_Click" Padding="10,4" Margin="8,0,0,0"/>
        </Grid>

        <CheckBox x:Name="SlideshowCheckBox" Content="Enable Slideshow" Margin="0,16,0,0" Foreground="{DynamicResource TextPrimaryBrush}"
                  Checked="Slideshow_Changed" Unchecked="Slideshow_Changed"/>

        <Grid x:Name="SlideshowFolderRow" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderTextBox" Grid.Column="0" IsReadOnly="True" VerticalContentAlignment="Center"
                     Padding="4,4"/>
            <Button Grid.Column="1" Content="Choose Folder" Click="ChooseFolder_Click" Padding="10,4" Margin="8,0,0,0"/>
        </Grid>

        <StackPanel x:Name="SlideshowIntervalRow" Orientation="Horizontal" Margin="0,8,0,0">
            <ComboBox x:Name="IntervalComboBox" Width="100" SelectionChanged="Slideshow_Changed"/>
            <CheckBox x:Name="ShuffleCheckBox" Content="Shuffle" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"
                      Checked="Slideshow_Changed" Unchecked="Slideshow_Changed"/>
        </StackPanel>
    </StackPanel>
</UserControl>
