<UserControl x:Class="CommandDash.App.Settings.GeneralSettingsView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:local="clr-namespace:CommandDash.App.Settings">
	<StackPanel Margin="4">
		<local:SettingsSectionHeader Title="General"/>
		<CheckBox x:Name="StartupCheckBox" Content="Launch on start up" Margin="0,0,0,8"
				  Foreground="{StaticResource TextPrimaryBrush}"
				  Checked="Startup_Changed" Unchecked="Startup_Changed"/>
		<Button Content="Open App Folder"
				Click="OpenAppFolder_Click"/>

        <local:SettingsSectionHeader Title="Focus Hotkey" Margin="0,16,0,0"/>
        <TextBlock Text="Bring CommandDash to the foreground from anywhere."
				   Margin="0,0,0,8" Foreground="{StaticResource TextSecondaryBrush}"/>
		<StackPanel Orientation="Horizontal">
			<TextBlock x:Name="HotkeyText" VerticalAlignment="Center" MinWidth="120" Margin="0,0,12,0"
					   Foreground="{StaticResource TextPrimaryBrush}"/>
			<Button Content="Change" Padding="10,4" Margin="0,0,8,0" Click="ChangeHotkey_Click"/>
			<Button Content="Default" Padding="10,4" Click="DefaultHotkey_Click"/>
		</StackPanel>
	</StackPanel>
</UserControl>
