<Window x:Class="CommandDash.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="480" Width="680"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Primary navigation: settings sections (sidebar). "Default" group
             renders with no header; any other group (e.g. "Modules") gets a
             label above its first section. -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
            <StackPanel x:Name="SectionPanel"/>
        </ScrollViewer>

        <!-- Secondary navigation: tabs within the selected section. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="SectionTitle" Grid.Row="0" Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

            <TabControl x:Name="SectionTabControl" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
