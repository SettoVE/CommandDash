<Window x:Class="CommandDash.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="480" Width="680"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Primary navigation: settings hierarchy (foobar2000-style
             preferences tree). No tabs; each node has its own single
             content page, and nodes can nest arbitrarily deep. -->
        <Border Grid.Column="0" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" Margin="0,0,16,0">
            <TreeView x:Name="SectionTree" Background="Transparent" BorderThickness="0"
                      SelectedItemChanged="SectionTree_SelectedItemChanged"/>
        </Border>

        <!-- Content area for the currently selected node. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="SectionTitle" Grid.Row="0" Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

            <ContentControl x:Name="SectionContentHost" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
