<Window x:Class="CommandDash.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="480" Width="380"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Module Order" Foreground="{DynamicResource TextPrimaryBrush}"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

        <ListBox x:Name="ModuleListBox" Grid.Row="1" Background="{DynamicResource CardBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="1"
                 BorderBrush="{DynamicResource BorderBrush2}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Move Up" Click="MoveUp_Click" Padding="10,4" Margin="0,0,8,0"/>
            <Button Content="Move Down" Click="MoveDown_Click" Padding="10,4"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Save" Click="Save_Click" Padding="12,6"/>
        </StackPanel>
    </Grid>
</Window>
