<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CommandDash.App</RootNamespace>
    <OutputType>WinExe</OutputType>
    <AssemblyName>dash</AssemblyName>
  </PropertyGroup>

  <!-- If Assets\app.ico exists at build time it becomes the exe's icon (file icon and pinned taskbar icon). -->
  <PropertyGroup Condition="Exists('Assets\app.ico')">
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommandDash.Core\CommandDash.Core.csproj" />
    <!-- Not referenced for compilation (ReferenceOutputAssembly=false); these
         only ensure the built-in modules build as part of the solution and
         let us copy their output into our own Modules folder below. The App
         loads them dynamically via ModuleLoader, not via a direct reference. -->
    <ProjectReference Include="..\CommandDash.Modules.Dashboard\CommandDash.Modules.Dashboard.csproj"
                       ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CommandDash.Modules.RunScript\CommandDash.Modules.RunScript.csproj"
                       ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CommandDash.Modules.Tasks\CommandDash.Modules.Tasks.csproj"
                       ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CommandDash.Modules.Routine\CommandDash.Modules.Routine.csproj"
                       ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Copy each built-in module's build output into this app's modules/
       folder so ModuleLoader can discover it at startup. -->
  <ItemGroup>
    <!-- Module projects are referenced with ReferenceOutputAssembly=false, so Visual Studio's
         fast up-to-date check would otherwise skip this project (and the copy below) when
         only a module changed. -->
    <UpToDateCheckInput Include="..\CommandDash.Modules.Dashboard\bin\$(Configuration)\$(TargetFramework)\CommandDash.Modules.Dashboard.dll" />
    <UpToDateCheckInput Include="..\CommandDash.Modules.RunScript\bin\$(Configuration)\$(TargetFramework)\CommandDash.Modules.RunScript.dll" />
    <UpToDateCheckInput Include="..\CommandDash.Modules.Tasks\bin\$(Configuration)\$(TargetFramework)\CommandDash.Modules.Tasks.dll" />
    <UpToDateCheckInput Include="..\CommandDash.Modules.Routine\bin\$(Configuration)\$(TargetFramework)\CommandDash.Modules.Routine.dll" />
  </ItemGroup>
  <Target Name="CopyModulesToModulesFolder" AfterTargets="Build">
    <ItemGroup>
      <BuiltInModuleOutput Include="..\CommandDash.Modules.Dashboard\bin\$(Configuration)\$(TargetFramework)\CommandDash.Modules.Dashboard.dll" />
      <BuiltInModuleOutput Include="..\CommandDash.Modules.Dashboard\bin\$(Configuration)\$(TargetFramework)\CommandDash.Modules.Dashboard.pdb" />
      <BuiltInModuleOutput Include="..\CommandDash.Modules.RunScript\bin\$(Configuration)\$(TargetFramework)\CommandDash.Modules.RunScript.dll" />
      <BuiltInModuleOutput Include="..\CommandDash.Modules.RunScript\bin\$(Configuration)\$(TargetFramework)\CommandDash.Modules.RunScript.pdb" />
      <BuiltInModuleOutput Include="..\CommandDash.Modules.Tasks\bin\$(Configuration)\$(TargetFramework)\CommandDash.Modules.Tasks.dll" />
      <BuiltInModuleOutput Include="..\CommandDash.Modules.Tasks\bin\$(Configuration)\$(TargetFramework)\CommandDash.Modules.Tasks.pdb" />
      <BuiltInModuleOutput Include="..\CommandDash.Modules.Routine\bin\$(Configuration)\$(TargetFramework)\CommandDash.Modules.Routine.dll" />
      <BuiltInModuleOutput Include="..\CommandDash.Modules.Routine\bin\$(Configuration)\$(TargetFramework)\CommandDash.Modules.Routine.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(BuiltInModuleOutput)" DestinationFolder="$(OutDir)modules\" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
