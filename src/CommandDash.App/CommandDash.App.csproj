<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CommandDash.App</RootNamespace>
    <OutputType>WinExe</OutputType>
    <AssemblyName>dash</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net8.0-windows\</OutputPath>
  </PropertyGroup>

  <!-- Smaller publish output. PublishTrimmed is intentionally not used: WPF does not support trimming and modules are loaded dynamically. -->
  <PropertyGroup>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- If Assets\app.ico exists at build time it becomes the exe's icon (file icon and pinned taskbar icon). -->
  <PropertyGroup Condition="Exists('Assets\app.ico')">
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Any Assets\LoadingBackground.* file (case-insensitive) is embedded as the loading screen background. -->
  <ItemGroup>
    <Resource Include="Assets\LoadingBackground.*" Link="Assets\LoadingBackground.img" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommandDash.Core\CommandDash.Core.csproj" />
    <!-- Not referenced for compilation (ReferenceOutputAssembly=false); these
         only ensure the built-in modules build as part of the solution. Their
         built DLLs are collected into @(BuiltInModule) (OutputItemType) and copied
         into our Modules folder below, so no target framework folder is hardcoded.
         The App loads them dynamically via ModuleLoader, not via a direct reference. -->
    <ProjectReference Include="..\CommandDash.Modules.Dashboard\CommandDash.Modules.Dashboard.csproj"
                       ReferenceOutputAssembly="false" OutputItemType="BuiltInModule" />
    <ProjectReference Include="..\CommandDash.Modules.RunScript\CommandDash.Modules.RunScript.csproj"
                       ReferenceOutputAssembly="false" OutputItemType="BuiltInModule" />
    <ProjectReference Include="..\CommandDash.Modules.Tasks\CommandDash.Modules.Tasks.csproj"
                       ReferenceOutputAssembly="false" OutputItemType="BuiltInModule" />
    <ProjectReference Include="..\CommandDash.Modules.Routine\CommandDash.Modules.Routine.csproj"
                       ReferenceOutputAssembly="false" OutputItemType="BuiltInModule" />
  </ItemGroup>

  <!-- Copy each built-in module's build output into this app's modules/
       folder so ModuleLoader can discover it at startup. -->
  <ItemGroup>
    <!-- Module projects are referenced with ReferenceOutputAssembly=false, so Visual Studio's
         fast up-to-date check would otherwise skip this project (and the copy below) when
         only a module changed. The wildcard is target framework agnostic. -->
    <UpToDateCheckInput Include="..\CommandDash.Modules.*\bin\$(Configuration)\**\CommandDash.Modules.*.dll" />
  </ItemGroup>
  <Target Name="CopyModulesToModulesFolder" AfterTargets="Build">
    <ItemGroup>
      <BuiltInModuleFile Include="@(BuiltInModule)" />
      <BuiltInModuleFile Include="@(BuiltInModule->'%(RootDir)%(Directory)%(Filename).pdb')" Condition="Exists('%(RootDir)%(Directory)%(Filename).pdb')" />
    </ItemGroup>
    <Error Condition="'@(BuiltInModule)' == ''" Text="No built-in module outputs were resolved; modules would not be copied." />
    <Copy SourceFiles="@(BuiltInModuleFile)" DestinationFolder="$(OutDir)modules\" SkipUnchangedFiles="true" />
    <MakeDir Directories="$(OutDir)scripts" />
  </Target>

</Project>
