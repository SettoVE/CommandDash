<UserControl x:Class="CommandDash.Modules.Sample.SampleModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
    <StackPanel Margin="4">
        <TextBlock Text="Sample Module" FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
        <TextBlock Text="This page is provided by CommandDash.Modules.Sample, a standalone module DLL that implements IModule."
                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="16" MaxWidth="360" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock x:Name="ClickCountText" Text="Clicked 0 times"
                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" Margin="0,0,0,12"/>
                <Button x:Name="ClickButton" Content="Click me" Click="ClickButton_Click"
                        Padding="12,6" HorizontalAlignment="Left"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
