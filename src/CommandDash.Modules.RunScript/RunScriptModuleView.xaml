<UserControl x:Class="CommandDash.Modules.RunScript.RunScriptModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CommandDash.Modules.RunScript">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <DataTemplate DataType="{x:Type local:ScriptItem}">
            <Border Margin="0,0,0,8" CornerRadius="8" BorderThickness="1" ClipToBounds="True"
                    Background="{DynamicResource WidgetGlassBrush}"
                    BorderBrush="{DynamicResource WidgetGlassBorderBrush}">
                <Grid>
                    <Border CornerRadius="8" IsHitTestVisible="False"
                            Background="{DynamicResource WidgetGlassSheenBrush}"/>
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding HotkeyText, StringFormat=[{0}]}" FontSize="14" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HotkeyText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Text="{Binding Status}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                       MaxHeight="120" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Run" FontSize="14" Padding="14,6" Margin="16,0,8,0"
                                Style="{DynamicResource PrimaryButtonStyle}" VerticalAlignment="Center"
                                Click="Run_Click"/>
                        <Button Grid.Column="2" Content="Bind" FontSize="14" Padding="14,6"
                                VerticalAlignment="Center" Click="Bind_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel Margin="4">
        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,4,0,0" Padding="8,4"
                Content="&#xE838;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24"
                ToolTip="Open scripts folder" Click="OpenFolder_Click"/>
        <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Visibility="Collapsed" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ScriptList"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
