<UserControl x:Class="CommandDash.Modules.RunScript.RunScriptSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="4">
        <TextBlock Text="Run Script" FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>

        <TextBlock Text="Scripts folder" Foreground="{DynamicResource TextPrimaryBrush}"/>
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderTextBox" Grid.Column="0" IsReadOnly="True" VerticalContentAlignment="Center"
                     Padding="4,4"/>
            <Button Grid.Column="1" Content="Choose Folder" Click="ChooseFolder_Click" Padding="10,4" Margin="8,0,0,0"/>
            <Button Grid.Column="2" Content="Default" Click="DefaultFolder_Click" Padding="10,4" Margin="8,0,0,0"/>
        </Grid>

        <TextBlock Text="Interpreters (leave empty to use PATH)" Margin="0,16,0,0"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>

        <TextBlock Text="Python (.py, .pyw)" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PythonTextBox" Grid.Column="0" VerticalContentAlignment="Center" Padding="4,4"
                     LostFocus="Interpreter_Changed"/>
            <Button Grid.Column="1" Content="Browse" Tag="Python" Click="Browse_Click" Padding="10,4" Margin="8,0,0,0"/>
            <Button Grid.Column="2" Content="Clear" Tag="Python" Click="ClearInterpreter_Click" Padding="10,4" Margin="8,0,0,0"/>
        </Grid>

        <TextBlock Text="PowerShell (.ps1)" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PowerShellTextBox" Grid.Column="0" VerticalContentAlignment="Center" Padding="4,4"
                     LostFocus="Interpreter_Changed"/>
            <Button Grid.Column="1" Content="Browse" Tag="PowerShell" Click="Browse_Click" Padding="10,4" Margin="8,0,0,0"/>
            <Button Grid.Column="2" Content="Clear" Tag="PowerShell" Click="ClearInterpreter_Click" Padding="10,4" Margin="8,0,0,0"/>
        </Grid>

        <TextBlock Text="Ruby (.rb)" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="RubyTextBox" Grid.Column="0" VerticalContentAlignment="Center" Padding="4,4"
                     LostFocus="Interpreter_Changed"/>
            <Button Grid.Column="1" Content="Browse" Tag="Ruby" Click="Browse_Click" Padding="10,4" Margin="8,0,0,0"/>
            <Button Grid.Column="2" Content="Clear" Tag="Ruby" Click="ClearInterpreter_Click" Padding="10,4" Margin="8,0,0,0"/>
        </Grid>
    </StackPanel>
</UserControl>
